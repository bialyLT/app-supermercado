# Provision separate LOGIN roles with membership in supermercado_app and supermercado_auth.
# Runtime connections must never use postgres, a table owner or BYPASSRLS.
DATABASE_URL="postgresql://app_runtime:replace-me@localhost:5432/supermercado"
AUTH_DATABASE_URL="postgresql://auth_runtime:replace-me@localhost:5432/supermercado"
MIGRATION_DATABASE_URL="postgresql://migration_owner:replace-me@localhost:5432/supermercado"
NODE_ENV="development"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
