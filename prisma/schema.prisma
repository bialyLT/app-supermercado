generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  slug      String        @unique
  stores    Store[]
  users     User[]
  roles     Role[]
  auditLogs AuditLog[]
  units UnitOfMeasure[]
  products Product[]
  variants ProductVariant[]
  barcodes Barcode[]
  prices Price[]
  locations Location[]
  lots Lot[]
  inventoryLevels InventoryLevel[]
  inventoryMovements InventoryMovement[]
  reservations Reservation[]
  unverifiedIntakes UnverifiedIntakeReview[]
  sales Sale[]
  payments Payment[]
  cashMovements CashMovement[]
  idempotencyCommands IdempotencyCommand[]
  intakePolicy UnverifiedIntakePolicy?
  discrepancies InventoryDiscrepancy[]
  registerSessions CashRegisterSession[]
  supervisorCredentials SupervisorCredential[]
  supervisorApprovals SupervisorApproval[]
  reversals SaleReversal[]
  reversalLines SaleReversalLine[]
  fiscalProfiles FiscalProfile[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum ProductKind {
  UNIT
  WEIGHT
  VOLUME
  LENGTH
}

enum BarcodeType {
  EAN
  UPC
  INTERNAL
  WEIGHT
}

enum PriceChannel {
  RETAIL
  WHOLESALE
  POS
}

enum LocationType {
  STORE
  WAREHOUSE
  DISPLAY
  TRANSIT
}

enum InventoryMovementType {
  RECEIPT
  SALE
  WASTE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  UNVERIFIED_INTAKE
  RETURN
}

enum MovementDirection {
  IN
  OUT
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum ReviewStatus {
  PENDING
  PENDING_REVIEW
  CONFIRMED
  CORRECTED
  REJECTED
}

enum IntakePolicyMode {
  DISABLED
  ALLOW_WITH_CAPS
  REQUIRE_SUPERVISOR
}

enum FiscalCondition {
  MONOTRIBUTO
  RESPONSABLE_INSCRIPTO
}

model Store {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid
  name      String
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  branches  Branch[]
  fiscalProfiles FiscalProfile[]
  createdAt DateTime       @default(now())
  @@unique([tenantId, id])
  @@index([tenantId])
}

model Branch {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @db.Uuid
  storeId       String         @db.Uuid
  code          String
  name          String
  store         Store          @relation(fields: [tenantId, storeId], references: [tenantId, id])
  cashRegisters CashRegister[]
  users         UserBranch[]
  locations     Location[]
  registerSessions CashRegisterSession[]
  reversals     SaleReversal[]
  createdAt     DateTime       @default(now())
  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model CashRegister {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  branchId  String   @db.Uuid
  name      String
  branch    Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id])
  registerSessions CashRegisterSession[]
  createdAt DateTime @default(now())
  @@unique([branchId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  email       String
  displayName String
  name        String   @default("")
  emailVerified Boolean @default(false)
  image       String?
  active      Boolean  @default(true)
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  roles       UserRole[]
  auditLogs   AuditLog[]
  accounts    Account[]
  sessions    Session[]
  branches    UserBranch[]
  registerSessions CashRegisterSession[] @relation("SessionCashier")
  closedRegisterSessions CashRegisterSession[] @relation("SessionCloser")
  supervisorCredentials SupervisorCredential[]
  payments Payment[]
  cashMovements CashMovement[]
  reversals SaleReversal[]
  requestedApprovals SupervisorApproval[] @relation("ApprovalRequester")
  grantedApprovals SupervisorApproval[] @relation("ApprovalApprover")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([tenantId, email])
  @@unique([email])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([identifier, value])
}

model UserBranch {
  tenantId String @db.Uuid
  userId   String @db.Uuid
  branchId String @db.Uuid
  user     User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  branch   Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  @@id([tenantId, userId, branchId])
  @@index([tenantId, branchId])
}

model Role {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @db.Uuid
  name      RoleName
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  users     UserRole[]
  createdAt DateTime   @default(now())
  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model UserRole {
  tenantId String @db.Uuid
  userId   String @db.Uuid
  roleId   String @db.Uuid
  user     User   @relation(fields: [tenantId, userId], references: [tenantId, id])
  role     Role   @relation(fields: [tenantId, roleId], references: [tenantId, id])
  @@id([tenantId, userId, roleId])
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  actorUserId   String?  @db.Uuid
  action        String
  entityType    String
  entityId      String?  @db.Uuid
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  correlationId String?
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  actor         User?    @relation(fields: [tenantId, actorUserId], references: [tenantId, id])
  @@index([tenantId, createdAt])
}

model UnitOfMeasure {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  code      String
  name      String
  precision Int      @default(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  products  Product[]
  variants  ProductVariant[]
  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  sku         String
  name        String
  description String?
  kind        ProductKind @default(UNIT)
  active      Boolean  @default(true)
  baseUnitId  String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  baseUnit    UnitOfMeasure @relation(fields: [tenantId, baseUnitId], references: [tenantId, id])
  variants    ProductVariant[]
  @@unique([tenantId, sku])
  @@unique([tenantId, id])
  @@index([tenantId, name])
}

model ProductVariant {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  productId   String   @db.Uuid
  unitId      String   @db.Uuid
  sku         String
  name        String
  attributes  Json?
  active      Boolean  @default(true)
  quantityPrecision Int @default(0)
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  product     Product  @relation(fields: [tenantId, productId], references: [tenantId, id])
  unit        UnitOfMeasure @relation(fields: [tenantId, unitId], references: [tenantId, id])
  barcodes    Barcode[]
  prices      Price[]
  inventoryLevels InventoryLevel[]
  inventoryMovements InventoryMovement[]
  reservations Reservation[]
  saleLines   SaleLine[]
  lots        Lot[]
  intakeReviews UnverifiedIntakeReview[]
  @@unique([tenantId, sku])
  @@unique([tenantId, id])
  @@index([tenantId, productId])
}

model Barcode {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  variantId String   @db.Uuid
  code      String
  type      BarcodeType @default(INTERNAL)
  active    Boolean  @default(true)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  variant   ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, variantId])
}

model Price {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  variantId String   @db.Uuid
  branchId  String?  @db.Uuid
  channel   PriceChannel @default(RETAIL)
  amount    Decimal  @db.Decimal(22, 4)
  currency  String?
  validFrom DateTime
  validTo   DateTime?
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  variant   ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id])
  @@index([tenantId, variantId, channel, validFrom])
}

model Location {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  branchId  String?  @db.Uuid
  code      String
  name      String
  type      LocationType @default(STORE)
  active    Boolean  @default(true)
  timeZone  String   @default("America/Argentina/Buenos_Aires")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  levels    InventoryLevel[]
  movements InventoryMovement[]
  reservations Reservation[]
  branch    Branch? @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "Location_tenant_branch_fkey")
  intakeReviews UnverifiedIntakeReview[]
  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, branchId])
}

model Lot {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  variantId   String   @db.Uuid
  lotNumber   String
  expiresAt   DateTime?
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  variant     ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "Lot_tenant_variant_fkey")
  levels      InventoryLevel[]
  movements   InventoryMovement[]
  reservations Reservation[]
  @@unique([tenantId, variantId, lotNumber])
  @@unique([tenantId, id])
}

model InventoryLevel {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  locationId  String   @db.Uuid
  variantId   String   @db.Uuid
  lotId       String?  @db.Uuid
  onHand      Decimal  @db.Decimal(18, 6)
  reserved    Decimal  @default(0) @db.Decimal(18, 6)
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  location    Location @relation(fields: [tenantId, locationId], references: [tenantId, id])
  variant     ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id])
  lot         Lot?     @relation(fields: [tenantId, lotId], references: [tenantId, id])
  movements   InventoryMovement[]
  reservations Reservation[]
  @@unique([tenantId, locationId, variantId, lotId])
  @@unique([tenantId, id])
  @@index([tenantId, variantId, locationId])
}

model InventoryMovement {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  locationId  String   @db.Uuid
  variantId   String   @db.Uuid
  lotId       String?  @db.Uuid
  type        InventoryMovementType
  direction   MovementDirection
  quantity    Decimal  @db.Decimal(18, 6)
  unitCost    Decimal? @db.Decimal(18, 2)
  referenceId String?
  reason      String?
  actorUserId String?  @db.Uuid
  createdAt   DateTime @default(now())
  idempotencyKey String?
  caseId      String? @db.Uuid
  registerSessionId String? @db.Uuid
  registerSession CashRegisterSession? @relation(fields: [tenantId, registerSessionId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  intakeCase  UnverifiedIntakeReview? @relation(fields: [tenantId, caseId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "Movement_tenant_case_fkey")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  location    Location @relation(fields: [tenantId, locationId], references: [tenantId, id])
  variant     ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id])
  lot         Lot?     @relation(fields: [tenantId, lotId], references: [tenantId, id])
  level       InventoryLevel? @relation(fields: [tenantId, locationId, variantId, lotId], references: [tenantId, locationId, variantId, lotId])
  @@index([tenantId, variantId, locationId, createdAt])
  @@unique([tenantId, idempotencyKey])
}

model Reservation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  locationId  String   @db.Uuid
  variantId   String   @db.Uuid
  lotId       String?  @db.Uuid
  quantity    Decimal  @db.Decimal(18, 6)
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime?
  referenceId  String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  location    Location @relation(fields: [tenantId, locationId], references: [tenantId, id])
  variant     ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id])
  lot         Lot?     @relation(fields: [tenantId, lotId], references: [tenantId, id])
  level       InventoryLevel? @relation(fields: [tenantId, locationId, variantId, lotId], references: [tenantId, locationId, variantId, lotId])
  @@index([tenantId, variantId, status])
}

model UnverifiedIntakeReview {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  locationId  String   @db.Uuid
  variantId   String   @db.Uuid
  lotId       String?  @db.Uuid
  quantity    Decimal  @db.Decimal(18, 6)
  reason      String
  status      ReviewStatus @default(PENDING_REVIEW)
  saleId      String? @db.Uuid
  saleLineId  String? @db.Uuid
  sessionId   String?
  registerSessionId String? @db.Uuid
  intakeValue Decimal? @db.Decimal(22, 4)
  currency String?
  registerSession CashRegisterSession? @relation(fields: [tenantId, registerSessionId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  businessDay String?
  correctionQuantity Decimal? @db.Decimal(18, 6)
  reviewedBy  String?  @db.Uuid
  reviewedAt  DateTime?
  createdBy   String?  @db.Uuid
  createdAt   DateTime @default(now())
  provider    String @default("UNKNOWN")
  costStatus  String @default("UNKNOWN")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  location    Location @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "Intake_tenant_location_fkey")
  variant     ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "Intake_tenant_variant_fkey")
  sale        Sale? @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "Intake_tenant_sale_fkey")
  saleLine    SaleLine? @relation(fields: [tenantId, saleLineId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "Intake_tenant_line_fkey")
  discrepancies InventoryDiscrepancy[] @relation("ScopedDiscrepancyReview")
  legacyDiscrepancies InventoryDiscrepancy[] @relation("LegacyDiscrepancyReview")
  movements InventoryMovement[]
  @@unique([tenantId, id])
  @@index([tenantId, status])
}

model UnverifiedIntakePolicy {
  tenantId              String @id @db.Uuid
  mode                  IntakePolicyMode @default(ALLOW_WITH_CAPS)
  maxLineQuantity       Decimal @default(10) @db.Decimal(18, 3)
  maxSessionQuantity    Decimal @default(30) @db.Decimal(18, 3)
  maxVariantDailyQuantity Decimal @default(20) @db.Decimal(18, 3)
  currency              String?
  maxSessionValue       Decimal? @db.Decimal(22, 4)
  reviewAfterDays       Int @default(7)
  tenant                Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model FiscalProfile {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  storeId       String   @db.Uuid
  country       String
  condition     FiscalCondition
  internalTicket Boolean
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  store         Store    @relation(fields: [tenantId, storeId], references: [tenantId, id])
  @@unique([tenantId, storeId])
  @@index([tenantId])
}

model IdempotencyCommand {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @db.Uuid
  commandId    String
  payloadHash  String
  resultType   String
  resultId     String
  result       Json?
  createdAt    DateTime @default(now())
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([tenantId, commandId])
}

model InventoryDiscrepancy {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @db.Uuid
  reviewId   String @unique @db.Uuid
  saleId     String @db.Uuid
  saleLineId String @db.Uuid
  sessionId  String
  registerSessionId String? @db.Uuid
  registerSession CashRegisterSession? @relation(fields: [tenantId, registerSessionId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  reason     String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  review UnverifiedIntakeReview @relation("ScopedDiscrepancyReview", fields: [tenantId, reviewId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "Discrepancy_tenant_review_fkey")
  legacyReview UnverifiedIntakeReview @relation("LegacyDiscrepancyReview", fields: [reviewId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sale Sale @relation("ScopedDiscrepancySale", fields: [tenantId, saleId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "Discrepancy_tenant_sale_fkey")
  legacySale Sale @relation("LegacyDiscrepancySale", fields: [saleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  saleLine SaleLine @relation("ScopedDiscrepancyLine", fields: [tenantId, saleLineId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "Discrepancy_tenant_line_fkey")
  legacySaleLine SaleLine @relation("LegacyDiscrepancyLine", fields: [saleLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([tenantId])
}

model Sale {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  locationId  String   @db.Uuid
  actorUserId String?  @db.Uuid
  total       Decimal  @db.Decimal(22, 4)
  currency    String?
  registerSessionId String? @db.Uuid
  registerSession CashRegisterSession? @relation(fields: [tenantId, registerSessionId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  lines       SaleLine[]
  scopedLines SaleLine[] @relation("ScopedSaleLine")
  payments    Payment[]
  intakeReviews UnverifiedIntakeReview[]
  reversals SaleReversal[]
  discrepancies InventoryDiscrepancy[] @relation("ScopedDiscrepancySale")
  legacyDiscrepancies InventoryDiscrepancy[] @relation("LegacyDiscrepancySale")
  fiscalSnapshot Json?
  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model SaleLine {
  id          String   @id @default(uuid()) @db.Uuid
  saleId      String   @db.Uuid
  tenantId   String   @db.Uuid
  variantId   String   @db.Uuid
  quantity    Decimal  @db.Decimal(18, 6)
  unitPrice   Decimal  @db.Decimal(22, 4)
  productName String
  sale        Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  scopedSale  Sale @relation("ScopedSaleLine", fields: [tenantId, saleId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "SaleLine_tenant_sale_fkey")
  variant     ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id])
  intakeReviews UnverifiedIntakeReview[]
  reversalLines SaleReversalLine[]
  discrepancies InventoryDiscrepancy[] @relation("ScopedDiscrepancyLine")
  legacyDiscrepancies InventoryDiscrepancy[] @relation("LegacyDiscrepancyLine")
  @@unique([tenantId, id])
  @@index([tenantId, variantId])
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  saleId      String        @db.Uuid
  amount      Decimal       @db.Decimal(22, 4)
  method      PaymentMethod
  currency    String
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  actorUserId String        @db.Uuid
  registerSessionId String? @db.Uuid
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sale        Sale          @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  actor       User          @relation(fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  registerSession CashRegisterSession? @relation(fields: [tenantId, registerSessionId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  @@unique([tenantId, id])
  @@index([tenantId, saleId])
  @@index([tenantId, registerSessionId])
}

model CashRegisterSession {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  registerId String @db.Uuid
  branchId String @db.Uuid
  userId String @db.Uuid
  currency String
  openedAt DateTime @db.Timestamptz(3)
  closedAt DateTime? @db.Timestamptz(3)
  closedBy String? @db.Uuid
  declaredCash Decimal? @db.Decimal(22,4)
  expectedCash Decimal? @db.Decimal(22,4)
  difference Decimal? @db.Decimal(22,4)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  register CashRegister @relation(fields: [tenantId, registerId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  cashier User @relation("SessionCashier", fields: [tenantId, userId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  closer User? @relation("SessionCloser", fields: [tenantId, closedBy], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  sales Sale[]
  reversals SaleReversal[]
  payments Payment[]
  movements InventoryMovement[]
  intakeReviews UnverifiedIntakeReview[]
  discrepancies InventoryDiscrepancy[]
  approvals SupervisorApproval[]
  cashMovements CashMovement[]
  @@unique([tenantId, id])
}

model SupervisorCredential {
  tenantId String @db.Uuid
  userId String @db.Uuid
  pinHash String
  failedAttempts Int @default(0)
  lockedUntil DateTime? @db.Timestamptz(3)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  @@id([tenantId, userId])
}

model SupervisorApproval {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  registerSessionId String @db.Uuid
  requesterId String @db.Uuid
  approverId String @db.Uuid
  commandHash String
  tokenHash String
  reason String
  createdAt DateTime @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  registerSession CashRegisterSession @relation(fields: [tenantId, registerSessionId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  requester User @relation("ApprovalRequester", fields: [tenantId, requesterId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  approver User @relation("ApprovalApprover", fields: [tenantId, approverId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  @@unique([tenantId, tokenHash])
}

enum CashMovementType {
  OPENING
  CASH_IN
  CASH_OUT
  CLOSING_COUNT
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  WALLET
}

enum SaleReversalType {
  ANNULMENT
  RETURN
}

enum SaleReversalStatus {
  COMPLETED
}

model CashMovement {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  registerSessionId String @db.Uuid
  type CashMovementType
  amount Decimal @db.Decimal(22,4)
  currency String
  actorUserId String @db.Uuid
  reason String
  referenceId String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  registerSession CashRegisterSession @relation(fields: [tenantId, registerSessionId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  actor User @relation(fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  @@unique([tenantId, id])
  @@index([tenantId, registerSessionId, createdAt])
}

model SaleReversal {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  saleId String @db.Uuid
  branchId String @db.Uuid
  registerSessionId String @db.Uuid
  type SaleReversalType
  status SaleReversalStatus @default(COMPLETED)
  actorUserId String @db.Uuid
  reason String
  idempotencyKey String
  total Decimal @db.Decimal(22,4)
  currency String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sale Sale @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  registerSession CashRegisterSession @relation(fields: [tenantId, registerSessionId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  actor User @relation(fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  lines SaleReversalLine[]
  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, saleId])
}

model SaleReversalLine {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  reversalId String @db.Uuid
  saleLineId String @db.Uuid
  quantity Decimal @db.Decimal(18,6)
  unitPrice Decimal @db.Decimal(22,4)
  total Decimal @db.Decimal(22,4)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversal SaleReversal @relation(fields: [tenantId, reversalId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  saleLine SaleLine @relation(fields: [tenantId, saleLineId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  @@unique([tenantId, id])
  @@unique([tenantId, reversalId, saleLineId])
  @@index([tenantId, saleLineId])
}

enum RoleName {
  CASHIER
  SUPERVISOR
  STOCK_MANAGER
  ADMIN
}
