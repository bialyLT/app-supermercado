generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  slug      String        @unique
  stores    Store[]
  users     User[]
  roles     Role[]
  auditLogs AuditLog[]
  units UnitOfMeasure[]
  products Product[]
  variants ProductVariant[]
  barcodes Barcode[]
  prices Price[]
  locations Location[]
  lots Lot[]
  inventoryLevels InventoryLevel[]
  inventoryMovements InventoryMovement[]
  reservations Reservation[]
  unverifiedIntakes UnverifiedIntakeReview[]
  sales Sale[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum ProductKind {
  UNIT
  WEIGHT
  VOLUME
  LENGTH
}

enum BarcodeType {
  EAN
  UPC
  INTERNAL
  WEIGHT
}

enum PriceChannel {
  RETAIL
  WHOLESALE
  POS
}

enum LocationType {
  STORE
  WAREHOUSE
  DISPLAY
  TRANSIT
}

enum InventoryMovementType {
  RECEIPT
  SALE
  WASTE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  UNVERIFIED_INTAKE
}

enum MovementDirection {
  IN
  OUT
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum ReviewStatus {
  PENDING
  CONFIRMED
  CORRECTED
  REJECTED
}

model Store {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid
  name      String
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  branches  Branch[]
  createdAt DateTime       @default(now())
  @@unique([tenantId, id])
  @@index([tenantId])
}

model Branch {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @db.Uuid
  storeId       String         @db.Uuid
  code          String
  name          String
  store         Store          @relation(fields: [tenantId, storeId], references: [tenantId, id])
  cashRegisters CashRegister[]
  users         UserBranch[]
  createdAt     DateTime       @default(now())
  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model CashRegister {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  branchId  String   @db.Uuid
  name      String
  branch    Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id])
  createdAt DateTime @default(now())
  @@unique([branchId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  email       String
  displayName String
  name        String   @default("")
  emailVerified Boolean @default(false)
  image       String?
  active      Boolean  @default(true)
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  roles       UserRole[]
  auditLogs   AuditLog[]
  accounts    Account[]
  sessions    Session[]
  branches    UserBranch[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([tenantId, email])
  @@unique([email])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([identifier, value])
}

model UserBranch {
  tenantId String @db.Uuid
  userId   String @db.Uuid
  branchId String @db.Uuid
  user     User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  branch   Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  @@id([tenantId, userId, branchId])
  @@index([tenantId, branchId])
}

model Role {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @db.Uuid
  name      RoleName
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  users     UserRole[]
  createdAt DateTime   @default(now())
  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model UserRole {
  tenantId String @db.Uuid
  userId   String @db.Uuid
  roleId   String @db.Uuid
  user     User   @relation(fields: [tenantId, userId], references: [tenantId, id])
  role     Role   @relation(fields: [tenantId, roleId], references: [tenantId, id])
  @@id([tenantId, userId, roleId])
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  actorUserId   String?  @db.Uuid
  action        String
  entityType    String
  entityId      String?  @db.Uuid
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  actor         User?    @relation(fields: [tenantId, actorUserId], references: [tenantId, id])
  @@index([tenantId, createdAt])
}

model UnitOfMeasure {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  code      String
  name      String
  precision Int      @default(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  products  Product[]
  variants  ProductVariant[]
  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  sku         String
  name        String
  description String?
  kind        ProductKind @default(UNIT)
  active      Boolean  @default(true)
  baseUnitId  String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  baseUnit    UnitOfMeasure @relation(fields: [tenantId, baseUnitId], references: [tenantId, id])
  variants    ProductVariant[]
  @@unique([tenantId, sku])
  @@unique([tenantId, id])
  @@index([tenantId, name])
}

model ProductVariant {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  productId   String   @db.Uuid
  unitId      String   @db.Uuid
  sku         String
  name        String
  attributes  Json?
  active      Boolean  @default(true)
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  product     Product  @relation(fields: [tenantId, productId], references: [tenantId, id])
  unit        UnitOfMeasure @relation(fields: [tenantId, unitId], references: [tenantId, id])
  barcodes    Barcode[]
  prices      Price[]
  inventoryLevels InventoryLevel[]
  inventoryMovements InventoryMovement[]
  reservations Reservation[]
  saleLines   SaleLine[]
  @@unique([tenantId, sku])
  @@unique([tenantId, id])
  @@index([tenantId, productId])
}

model Barcode {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  variantId String   @db.Uuid
  code      String
  type      BarcodeType @default(INTERNAL)
  active    Boolean  @default(true)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  variant   ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, variantId])
}

model Price {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  variantId String   @db.Uuid
  branchId  String?  @db.Uuid
  channel   PriceChannel @default(RETAIL)
  amount    Decimal  @db.Decimal(18, 2)
  validFrom DateTime
  validTo   DateTime?
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  variant   ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id])
  @@index([tenantId, variantId, channel, validFrom])
}

model Location {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  branchId  String?  @db.Uuid
  code      String
  name      String
  type      LocationType @default(STORE)
  active    Boolean  @default(true)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  levels    InventoryLevel[]
  movements InventoryMovement[]
  reservations Reservation[]
  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, branchId])
}

model Lot {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  variantId   String   @db.Uuid
  lotNumber   String
  expiresAt   DateTime?
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  levels      InventoryLevel[]
  movements   InventoryMovement[]
  reservations Reservation[]
  @@unique([tenantId, variantId, lotNumber])
  @@unique([tenantId, id])
}

model InventoryLevel {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  locationId  String   @db.Uuid
  variantId   String   @db.Uuid
  lotId       String?  @db.Uuid
  onHand      Decimal  @db.Decimal(18, 6)
  reserved    Decimal  @default(0) @db.Decimal(18, 6)
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  location    Location @relation(fields: [tenantId, locationId], references: [tenantId, id])
  variant     ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id])
  lot         Lot?     @relation(fields: [tenantId, lotId], references: [tenantId, id])
  movements   InventoryMovement[]
  reservations Reservation[]
  @@unique([tenantId, locationId, variantId, lotId])
  @@unique([tenantId, id])
  @@index([tenantId, variantId, locationId])
}

model InventoryMovement {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  locationId  String   @db.Uuid
  variantId   String   @db.Uuid
  lotId       String?  @db.Uuid
  type        InventoryMovementType
  direction   MovementDirection
  quantity    Decimal  @db.Decimal(18, 6)
  unitCost    Decimal? @db.Decimal(18, 2)
  referenceId String?
  reason      String?
  actorUserId String?  @db.Uuid
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  location    Location @relation(fields: [tenantId, locationId], references: [tenantId, id])
  variant     ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id])
  lot         Lot?     @relation(fields: [tenantId, lotId], references: [tenantId, id])
  level       InventoryLevel? @relation(fields: [tenantId, locationId, variantId, lotId], references: [tenantId, locationId, variantId, lotId])
  @@index([tenantId, variantId, locationId, createdAt])
}

model Reservation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  locationId  String   @db.Uuid
  variantId   String   @db.Uuid
  lotId       String?  @db.Uuid
  quantity    Decimal  @db.Decimal(18, 6)
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime?
  referenceId  String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  location    Location @relation(fields: [tenantId, locationId], references: [tenantId, id])
  variant     ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id])
  lot         Lot?     @relation(fields: [tenantId, lotId], references: [tenantId, id])
  level       InventoryLevel? @relation(fields: [tenantId, locationId, variantId, lotId], references: [tenantId, locationId, variantId, lotId])
  @@index([tenantId, variantId, status])
}

model UnverifiedIntakeReview {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  locationId  String   @db.Uuid
  variantId   String   @db.Uuid
  lotId       String?  @db.Uuid
  quantity    Decimal  @db.Decimal(18, 6)
  reason      String
  status      ReviewStatus @default(PENDING)
  correctionQuantity Decimal? @db.Decimal(18, 6)
  reviewedBy  String?  @db.Uuid
  reviewedAt  DateTime?
  createdBy   String?  @db.Uuid
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  @@index([tenantId, status])
}

model Sale {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  locationId  String   @db.Uuid
  actorUserId String?  @db.Uuid
  total       Decimal  @db.Decimal(18, 2)
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  lines       SaleLine[]
  @@index([tenantId, createdAt])
}

model SaleLine {
  id          String   @id @default(uuid()) @db.Uuid
  saleId      String   @db.Uuid
  tenantId   String   @db.Uuid
  variantId   String   @db.Uuid
  quantity    Decimal  @db.Decimal(18, 6)
  unitPrice   Decimal  @db.Decimal(18, 2)
  productName String
  sale        Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id])
  @@index([tenantId, variantId])
}

enum RoleName {
  CASHIER
  SUPERVISOR
  STOCK_MANAGER
  ADMIN
}
