generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  slug      String        @unique
  stores    Store[]
  users     User[]
  roles     Role[]
  auditLogs AuditLog[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Store {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid
  name      String
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  branches  Branch[]
  createdAt DateTime       @default(now())
  @@unique([tenantId, id])
  @@index([tenantId])
}

model Branch {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @db.Uuid
  storeId       String         @db.Uuid
  code          String
  name          String
  store         Store          @relation(fields: [tenantId, storeId], references: [tenantId, id])
  cashRegisters CashRegister[]
  users         UserBranch[]
  createdAt     DateTime       @default(now())
  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model CashRegister {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  branchId  String   @db.Uuid
  name      String
  branch    Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id])
  createdAt DateTime @default(now())
  @@unique([branchId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  email       String
  displayName String
  name        String   @default("")
  emailVerified Boolean @default(false)
  image       String?
  active      Boolean  @default(true)
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  roles       UserRole[]
  auditLogs   AuditLog[]
  accounts    Account[]
  sessions    Session[]
  branches    UserBranch[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([tenantId, email])
  @@unique([email])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([identifier, value])
}

model UserBranch {
  tenantId String @db.Uuid
  userId   String @db.Uuid
  branchId String @db.Uuid
  user     User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  branch   Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  @@id([tenantId, userId, branchId])
  @@index([tenantId, branchId])
}

model Role {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @db.Uuid
  name      RoleName
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  users     UserRole[]
  createdAt DateTime   @default(now())
  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model UserRole {
  tenantId String @db.Uuid
  userId   String @db.Uuid
  roleId   String @db.Uuid
  user     User   @relation(fields: [tenantId, userId], references: [tenantId, id])
  role     Role   @relation(fields: [tenantId, roleId], references: [tenantId, id])
  @@id([tenantId, userId, roleId])
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  actorUserId   String?  @db.Uuid
  action        String
  entityType    String
  entityId      String?  @db.Uuid
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  actor         User?    @relation(fields: [tenantId, actorUserId], references: [tenantId, id])
  @@index([tenantId, createdAt])
}

enum RoleName {
  CASHIER
  SUPERVISOR
  STOCK_MANAGER
  ADMIN
}
